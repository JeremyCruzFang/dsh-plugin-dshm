{
  "name": "dsh-plugin-dshm",
  "version": "0.1.2",
  "description": "Pair your iPhone or iPad with DeepSeek Harness over a private, authenticated connection",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremyCruzFang/dsh-plugin-dshm.git",
    "directory": "bridge"
  },
  "homepage": "https://github.com/JeremyCruzFang/dsh-plugin-dshm/tree/main/bridge#readme",
  "bugs": { "url": "https://github.com/JeremyCruzFang/dsh-plugin-dshm/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "dshm", "ios", "remote-control"],
  "packageManager": "pnpm@11.13.1",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "private": false,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js",
    "./cli": "./lib/cli/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.3 || 0.2.1-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json && node scripts/build-client.mjs && node scripts/pack-protocol.mjs",
    "test": "pnpm build && node --test --test-timeout=30000 test/*.test.mjs src/projection/*.test.mjs",
    "test:integration": "node ../tools/bridge-integration/run.mjs",
    "prepack": "pnpm build",
    "test:host": "node ../tools/bridge-integration/run-host-ux.mjs",
    "test:discovery": "node --test test/discovery-live.mjs"
  },
  "dependencies": {
    "multicast-dns": "7.2.5",
    "qrcode": "1.5.4",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/multicast-dns": "7.2.4",
    "@types/node": "24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "dshm-protocol": "file:../protocol"
  }
}
